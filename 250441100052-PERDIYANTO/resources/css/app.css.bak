@import 'tailwindcss';

@source '../../vendor/laravel/framework/src/Illuminate/Pagination/resources/views/*.blade.php';
@source '../../storage/framework/views/*.php';

@theme {
    --font-sans: 'Instrument Sans', ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji',
        'Segoe UI Symbol', 'Noto Color Emoji';
}

:root {
    --warna-header: #2c3e5c;
    --warna-background: #f4f6f8;
    --warna-kartu: #ffffff;
    --warna-teks: #26303d;
    --warna-teks-sekunder: #7a8699;
    --warna-aksen: #4a6da7;
    --warna-border: #dde3ea;
}

body {
    background-color: var(--warna-background);
    color: var(--warna-teks);
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

.container {
    width: 100%;
    margin: 20px auto;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
    border-radius: 20px;
}

.container header {
    background-color: var(--warna-header);
    color: #ffffff;
    padding: 10px;
    border-radius: 20px;
    font-size: large;
    font-weight: bold;
}

.container nav {
    font-size: medium;
    width: 20%;
    display: flex;
    justify-content: space-between;
    font-weight: 500;
}

@media (max-width: 1020px) {
    .container nav {
        font-size: medium;
        width: 35%;
        display: flex;
        justify-content: space-between;
        font-weight: 500;
    }
}

main {
    flex: 1;
    padding-bottom: 24px;
}

.home {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    max-width: 1000px;
    margin: auto;
    margin-top: 30px;
    margin-bottom: 100px;
}

.home img {
    width: 250px;
    border-radius: 15px 50px 15px 50px;
}

.home p {
    font-size: 18px;
    line-height: 1.6;
    font-weight: 500;
    color: var(--warna-teks-sekunder);
    max-width: 600px;
}

.home p span {
    font-size: 25px;
    line-height: 1.6;
    font-weight: 800;
    color: var(--warna-header);
    max-width: 600px;
}

footer {
    background-color: var(--warna-header);
    color: #ffffff;
    padding: 20px;
    text-align: center;
    width: 100%;
}

h2 {
    color: var(--warna-header);
    text-align: center;
    font-size: larger;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 20px;
}

.daftar-buku {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 15px;
}

.kartu-buku {
    background-color: var(--warna-kartu);
    border: 1px solid var(--warna-border);
    border-radius: 10px;
    padding: 20px;
}

.kartu-buku h3 {
    margin-top: 0;
    color: var(--warna-header);
}

.kartu-buku p {
    font-size: 14px;
    color: var(--warna-teks-sekunder);
}

.kartu-buku a {
    display: inline-block;
    margin-top: 10px;
    padding: 8px 14px;
    background-color: var(--warna-aksen);
    color: #ffffff;
    text-decoration: none;
    border-radius: 6px;
}

@media (max-width: 1020px) {
    .daftar-buku {
        grid-template-columns: 1fr;
    }
}

.detail-buku {
    background-color: var(--warna-kartu);
    border: 1px solid var(--warna-border);
    border-radius: 10px;
    padding: 24px;
    max-width: 600px;
    margin: 0 auto;
}

.detail-buku h3 {
    margin-top: 0;
    color: var(--warna-header);
    font-size: 22px;
}

.detail-buku p {
    color: var(--warna-teks-sekunder);
    font-size: 15px;
}

.detail-buku a {
    display: inline-block;
    margin-top: 14px;
    color: var(--warna-aksen);
    text-decoration: none;
    font-weight: 500;
}

.detail-buku a:hover {
    text-decoration: underline;
}

[hidden] {
    display: none !important;
}

.tabel-buku {
    width: calc(100% - 40px);
    margin: 0 20px;
    border-collapse: collapse;
    background-color: var(--warna-kartu);
}

.tabel-buku th,
.tabel-buku td {
    border: 1px solid var(--warna-border);
    padding: 8px 12px;
    text-align: left;
}

.tabel-buku th {
    background-color: var(--warna-header);
    color: #ffffff;
}

.paginasi {
    margin: 12px 20px 0;
    display: flex;
    align-items: center;
    gap: 12px;
}

#alert-area {
    margin: 0 20px;
}

.pesan {
    padding: 10px 14px;
    border-radius: 8px;
    margin-bottom: 12px;
}

.pesan-sukses {
    background-color: #e6f4ea;
    color: #1e6b34;
}

.pesan-peringatan {
    background-color: #fff4e0;
    color: #8a5a00;
}

.pesan-error {
    background-color: #fdeaea;
    color: #a12a2a;
}

.form-buku {
    margin: 0 20px 20px;
    padding: 16px;
    background-color: var(--warna-kartu);
    border: 1px solid var(--warna-border);
    border-radius: 10px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
    align-items: start;
}

.kolom-form {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.kolom-form label {
    font-weight: 500;
    font-size: 14px;
}

.kolom-form input,
.kolom-form select {
    padding: 8px 10px;
    border: 1px solid var(--warna-border);
    border-radius: 6px;
    background-color: #ffffff;
}

.err {
    color: #a12a2a;
    font-size: 12px;
    min-height: 16px;
}

.aksi-form {
    display: flex;
    gap: 8px;
    align-items: flex-end;
}

.form-buku button,
.paginasi button,
.tabel-buku button {
    padding: 8px 14px;
    border: 1px solid var(--warna-border);
    border-radius: 6px;
    background-color: var(--warna-kartu);
    color: var(--warna-teks);
    cursor: pointer;
}

.form-buku button[type="submit"] {
    background-color: var(--warna-aksen);
    border-color: var(--warna-aksen);
    color: #ffffff;
}

.paginasi button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.tabel-buku td button + button {
    margin-left: 6px;
}

.tabel-buku .btn-hapus {
    color: #a12a2a;
    border-color: #e3b4b4;
}